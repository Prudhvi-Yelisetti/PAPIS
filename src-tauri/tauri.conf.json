{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "PAPIS",
  "version": "0.1.0",
  "identifier": "dev.papis.app",

  "build": {
    "beforeDevCommand":   "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl":             "http://localhost:1420",
    "frontendDist":       "../dist"
  },

  "app": {
    "windows": [
      {
        "title":            "PAPIS — Package Intelligence",
        "width":            1280,
        "height":           800,
        "minWidth":         900,
        "minHeight":        600,
        "resizable":        true,
        "fullscreen":       false,
        "decorations":      true,
        "transparent":      false,
        "center":           true,
        "label":            "main"
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'", "tauri:"],
        "connect-src": [
          "'self'",
          "http://127.0.0.1:8765",
          "ws://127.0.0.1:8765"
        ],
        "img-src":    ["'self'", "asset:", "data:"],
        "style-src":  ["'self'", "'unsafe-inline'"],
        "script-src": ["'self'"]
      }
    },
    "trayIcon": {
      "iconPath":    "icons/tray.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "title":       "PAPIS"
    }
  },

  "bundle": {
    "active":      true,
    "targets":     ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["python3", "python3-pip", "socat", "curl", "jq"]
      }
    },
    "resources": [
      "../backend/**",
      "../daemon/**",
      "../linux-integration/**"
    ],
    "externalBin": []
  },

  "plugins": {
    "shell":         { "open": true,  "sidecar": false, "scope": [] },
    "dialog":        { "open": true,  "save": true  },
    "notification":  { "all": true },
    "autostart":     { "desktopTemplate": null },
    "process":       {},
    "fs": {
      "scope": {
        "allow": ["$HOME/**"],
        "deny":  ["$HOME/.ssh/**", "$HOME/.gnupg/**"]
      }
    }
  }
}